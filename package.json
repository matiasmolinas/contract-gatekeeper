{
  "name": "contract-gatekeeper",
  "version": "1.0.0",
  "description": "Deterministic pre-PR and CI contract verifier for parallel coding agents",
  "type": "module",
  "bin": {
    "contract-gatekeeper": "./dist/cli.js"
  },
  "main": "./dist/engine.js",
  "types": "./dist/engine.d.ts",
  "exports": {
    ".": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "tsx src/cli.ts check",
    "test": "tsx test/gatekeeper.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matiasmolinas/contract-gatekeeper.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "Apache-2.0"
}
